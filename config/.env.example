# Final Site Enrollment PowerSchool Sync - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to git - it's already in .gitignore

# PowerSchool API Configuration
POWERSCHOOL_URL=https://your-powerschool-instance.powerschool.com
POWERSCHOOL_CLIENT_ID=your_client_id_here
POWERSCHOOL_CLIENT_SECRET=your_client_secret_here

# SFTP Configuration (if used)
SFTP_HOST=your-sftp-host.example.com
SFTP_PORT=22
SFTP_USERNAME=your_sftp_username
SFTP_PASSWORD=your_sftp_password
# Or use key-based auth (preferred):
# SFTP_PRIVATE_KEY_PATH=/path/to/private/key

# Database Configuration (if used)
DB_CONNECTION_STRING=Server=yourserver;Database=yourdb;User Id=youruser;Password=yourpassword;

# Optional: Encryption key for securing cached data
CACHE_ENCRYPTION_KEY=generate_a_random_32_character_key_here

# Logging Level
LOG_LEVEL=Info
